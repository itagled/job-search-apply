# Generated with: jobradar config --env-example

# --- Database ---
# SQLAlchemy URL of the database: a SQLite file to start (relative to the project), or Postgres (postgresql://user:password@host:5432/dbname).
DATABASE_URL=sqlite:///data/jobradar.db

# --- LLM (NanoGPT or OpenRouter, OpenAI-compatible APIs) ---
# nanogpt | openrouter. Empty: the one whose key is set, NanoGPT first. Jev (the title check and the pre-filter) is only on NanoGPT.
LLM_PROVIDER=
# NanoGPT API key: https://nano-gpt.com/api
NANOGPT_API_KEY=
# NanoGPT API base URL. Default: https://nano-gpt.com/api/v1
# NANOGPT_BASE_URL=https://nano-gpt.com/api/v1
# OpenRouter API key, instead of NanoGPT: https://openrouter.ai/settings/keys
OPENROUTER_API_KEY=
# OpenRouter API base URL. Default: https://openrouter.ai/api/v1
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Fit scorer model (final note with explanation). Default: deepseek/deepseek-v4-pro
# FIT_MODEL=deepseek/deepseek-v4-pro
# Cheap pre-filter before the LLM: jev | none. Jev needs NanoGPT: on OpenRouter every posting goes to the LLM. Default: jev
# FIT_TRIAGE=jev
# Minimum Jev score (0-100) to pass to the LLM. Default: 25
# FIT_TRIAGE_MIN=25
# Jev model (NanoGPT /systemone): the title check and the pre-filter. Default: typesafe/jev-latest
# JEV_MODEL=typesafe/jev-latest
# Cheap model that checks job titles where there is no Jev (OpenRouter). Default: deepseek/deepseek-v4-flash-0731
# TITLE_MODEL=deepseek/deepseek-v4-flash-0731
# Minimum probability (0-1) for a job title to pass the check. Default: 0.2
# TITLE_MIN=0.2
# Model that classifies companies (startup / fit with the profile). Default: deepseek/deepseek-v4-flash-0731
# CLASSIFY_MODEL=deepseek/deepseek-v4-flash-0731
# Model that decides if a LinkedIn post is a job offer. Default: deepseek/deepseek-v4-flash-0731
# CLASSIFY_POST_MODEL=deepseek/deepseek-v4-flash-0731
# Cheap model that classifies LinkedIn hiring posts. Default: google/gemini-3.1-flash-lite
# POSTS_MODEL=google/gemini-3.1-flash-lite
# Disk cache of LLM responses (1/0): the same call is not paid twice. Default: 1
# LLM_CACHE=1

# --- Apify (paid scrapers) ---
# Apify API token: https://console.apify.com/settings/integrations
APIFY_API_TOKEN=
# LinkedIn Jobs listings actor. Default: valig/linkedin-jobs-scraper
# APIFY_LINKEDIN_JOBS_ACTOR=valig/linkedin-jobs-scraper
# Actor for posts of a LinkedIn profile. Default: harvestapi/linkedin-profile-posts
# APIFY_LINKEDIN_PROFILE_POSTS_ACTOR=harvestapi/linkedin-profile-posts
# Actor for employees of a company on LinkedIn. Default: harvestapi/linkedin-company-employees
# APIFY_EMPLOYEES_ACTOR=harvestapi/linkedin-company-employees
# Countries where to search employees, comma-separated (default: the country in the profile).
APIFY_EMPLOYEES_LOCATIONS=
# Google results actor. Default: scraperlink/google-search-results-serp-scraper
# APIFY_SERP_ACTOR=scraperlink/google-search-results-serp-scraper

# --- Other data providers ---
# Apollo API key (companies and decision-maker emails).
APOLLO_API_KEY=
# Serper API key (Google Search), enrichment fallback.
SERPER_API_KEY=

# --- Google (Gmail, Calendar, Drive) ---
# OAuth client id to read Gmail alerts (also works in CI).
GMAIL_CLIENT_ID=
# OAuth client secret to read Gmail alerts.
GMAIL_CLIENT_SECRET=
# Refresh token (scope gmail.readonly) to read alerts.
GMAIL_REFRESH_TOKEN=
# Google token endpoint. Default: https://oauth2.googleapis.com/token
# GMAIL_TOKEN_URI=https://oauth2.googleapis.com/token
# Email from which applications and drafts are sent.
GMAIL_SENDER=you@example.com
# Name shown as sender.
GMAIL_SENDER_NAME=First Last
# OAuth credentials (JSON) to regenerate the read token.
GMAIL_READ_CLIENT_SECRETS=secrets/gmail_read_credentials.json
# Where to save the read token when reauthorizing.
GMAIL_READ_TOKEN_PATH=secrets/token_gmail.json

# --- Personalization: profile, language and CV files ---
# Target profile: TOML header with search/filter/scoring settings + ideal-role text. Default: profile/target.md
# PROFILE_PATH=profile/target.md
# Language of the status page: en | es. Default: en
# UI_LANGUAGE=en
# Prefix of the CV files: <prefix>_<Company> (tailored) and <prefix>_<EN|ES> (masters). Default: CV
# CV_FILE_PREFIX=CV
